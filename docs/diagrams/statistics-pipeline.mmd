%% Editable source for the committed SVG and PNG.
flowchart TB
    accTitle: UFC Forecast MySQL architecture
    accDescr: Immutable source captures normalize directly into versioned MySQL datasets. Quality checks precede activation. Native operating records, research data, published rankings, forecasts and append-only forward ledgers remain separate. Streamlit reads committed MySQL evidence and verified report exports. Scheduled refreshes retain run receipts and notify on failures.
    subgraph SOURCES["01 / SOURCE EVIDENCE"]
        ARCHIVE["Pinned UFCStats archive<br/>CSV bytes + source hashes"]
        RANKINGS["Official UFC rankings<br/>Meta + media · champion + top 15"]
        LEGACY["Retained legacy evidence<br/>One-time read-only import"]
    end
    RAW["Immutable file archive<br/>Capture time · SHA-256 · provenance"]
    BUILD["Native MySQL normalization<br/>Exact identities · paired rounds<br/>Missing values stay NULL"]
    GATE["Quality gates<br/>Nonempty + retention threshold<br/>Held rows stay inspectable"]
    MYSQL[("MySQL 8.4 / InnoDB<br/>Versioned statistics + research datasets<br/>Operating records + source receipts")]
    PUBLISH["Verified publication<br/>Atomic dataset alias + receipt<br/>Versioned analytical SQL views"]
    DELIVERY[("MySQL delivery evidence<br/>Rankings · evaluations · frozen reports<br/>Append-only forecast hash chain")]
    MODEL["Separate research evaluation<br/>Earlier fights + date embargo<br/>Style · finishes · opponent strength"]
    APP["Read-only Streamlit dashboard<br/>Card · history · model · quality<br/>Ledgers · forward test · rankings"]
    FILES["Verified report exports<br/>PDF · HTML · CSV · JSON"]
    OPS["Local scheduling / manual refresh<br/>launchd 09:00 · run receipts<br/>Failure: Mac notification"]
    DEMO["Isolated synthetic MySQL demo<br/>Same parser · explicit quality fixtures<br/>Never activates the real archive"]
    ARCHIVE --> RAW --> BUILD --> GATE --> MYSQL --> PUBLISH
    LEGACY -.->|migration only| MYSQL
    RANKINGS --> RAW
    RANKINGS --> DELIVERY
    PUBLISH --> MODEL --> DELIVERY
    PUBLISH --> APP
    DELIVERY --> APP
    DELIVERY --> FILES --> APP
    OPS -.-> BUILD
    OPS -.-> GATE
    DEMO -.-> BUILD
    classDef source fill:#eef4f2,stroke:#54796c,color:#17382d;
    classDef process fill:#fff,stroke:#63786e,color:#1d352b;
    classDef store fill:#e8f1ed,stroke:#28745d,color:#173b2c,stroke-width:2px;
    classDef gate fill:#fff5e8,stroke:#aa7636,color:#66451f;
    classDef research fill:#f2eff7,stroke:#8e7da6,color:#55446c;
    class ARCHIVE,RANKINGS,LEGACY,RAW source;
    class BUILD,PUBLISH,APP,FILES process;
    class MYSQL,DELIVERY store;
    class GATE,DEMO gate;
    class MODEL,OPS research;
