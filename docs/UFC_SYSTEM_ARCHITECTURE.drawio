        <mxCell id="sportradar" value="&lt;b&gt;◇ Sportradar MMA API&lt;/b&gt;&lt;br&gt;UFC cards, status, results&lt;br&gt;Adapter built; key / licensed access needed" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#C67C16;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
