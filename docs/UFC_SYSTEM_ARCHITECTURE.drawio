        <mxCell id="inplay_future" value="&lt;b&gt;○ Future in-play work — blocked / not implemented&lt;/b&gt;&lt;br&gt;Needs observed, published and fetched metric timestamps plus a contemporaneous executable quote and settlement checks. A wider modeled edge cannot correct unknown data latency." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F8F6FF;strokeColor=#7557B8;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
