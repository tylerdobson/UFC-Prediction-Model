        <mxCell id="sportradar" value="&lt;b&gt;! Primary source access pending&lt;/b&gt;&lt;br&gt;Confirm rights for private betting decisions,&lt;br&gt;raw retention, training and display&lt;br&gt;No operating fight-history source selected" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#C67C16;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="245" width="355" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ufcstats" value="&lt;b&gt;UFC history feed candidates&lt;/b&gt;&lt;br&gt;UFCalendar / Sportradar: terms and&lt;br&gt;observation times need confirmation&lt;br&gt;UFCStats scraping is not cleared" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#C67C16;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="447" width="355" height="170" as="geometry" />
        </mxCell>
        <mxCell id="oddsapi" value="&lt;b&gt;The Odds API&lt;/b&gt;&lt;br&gt;Prospective UFC h2h quotes&lt;br&gt;Adapter built; key still needed&lt;br&gt;Historical prices require paid access" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#C67C16;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="649" width="355" height="170" as="geometry" />
        </mxCell>
        <mxCell id="source_review" value="&lt;b&gt;● Reviewed CSV import&lt;/b&gt;&lt;br&gt;Use a source with documented rights&lt;br&gt;Include reviewer, source and UTC&lt;br&gt;observation time for live rosters" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="851" width="355" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fetch" value="&lt;b&gt;● Fetch or import&lt;/b&gt;&lt;br&gt;Scheduled CLI runs or reviewed CSV&lt;br&gt;Capture source and UTC receipt time" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="245" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;● Immutable raw receipts&lt;/b&gt;&lt;br&gt;Keep original JSON / HTML / CSV&lt;br&gt;SHA-256 + ingestion_runs record&lt;br&gt;Never overwrite source payloads" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="425" width="355" height="160" as="geometry" />
        </mxCell>
        <mxCell id="normalize" value="&lt;b&gt;● Normalize status and prices&lt;/b&gt;&lt;br&gt;Resolve event / bout status and results&lt;br&gt;Retain bookmaker update + fetch times&lt;br&gt;Hold ambiguous quote or bout matches" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="620" width="355" height="170" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;● Stable fighter ID mapping&lt;/b&gt;&lt;br&gt;Review cross-provider links explicitly&lt;br&gt;Never merge fighters by name alone" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="825" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;● SQLite + versioned SQL&lt;/b&gt;&lt;br&gt;fighters · events · bouts · results&lt;br&gt;card / profile / stat observations&lt;br&gt;odds_quotes · predictions · gate checks&lt;br&gt;paper_bets · bets · ingestion_runs" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="245" width="355" height="190" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;● Audit gate: stop or review&lt;/b&gt;&lt;br&gt;Stable IDs, card completeness and&lt;br&gt;opponent substitutions&lt;br&gt;Cancelled / draw / no contest rules&lt;br&gt;Timestamp and price availability" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="475" width="355" height="195" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="&lt;b&gt;! Resolve uncertain source rows&lt;/b&gt;&lt;br&gt;Exclude affected bouts and prices&lt;br&gt;from model decisions; rerun audit" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFF1EC;strokeColor=#DB765C;strokeWidth=2;fontColor=#5B2830;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="707" width="355" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cutoff" value="&lt;b&gt;● UTC time contract&lt;/b&gt;&lt;br&gt;Use earlier evidence only&lt;br&gt;Event start is a conservative&lt;br&gt;card-level cutoff, not bout start" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="875" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="features" value="&lt;b&gt;● Point-in-time features&lt;/b&gt;&lt;br&gt;Earlier bouts only: Elo, form, rest&lt;br&gt;Age / reach from dated observations&lt;br&gt;Prior opponent-adjusted stats" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="245" width="355" height="175" as="geometry" />
        </mxCell>
        <mxCell id="missing_stats" value="&lt;b&gt;● Coverage and missingness&lt;/b&gt;&lt;br&gt;Neutral fallback if dated data missing&lt;br&gt;Record per-prediction feature coverage&lt;br&gt;No current career averages in history" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="450" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;● Probability candidates&lt;/b&gt;&lt;br&gt;Elo + regularized logistic&lt;br&gt;No-vig bookmaker baseline&lt;br&gt;Calibrate on later validation events" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="625" width="355" height="155" as="geometry" />
        </mxCell>
        <mxCell id="evaluate" value="&lt;b&gt;● Chronological evaluation&lt;/b&gt;&lt;br&gt;Early training → later calibration&lt;br&gt;→ untouched later test events&lt;br&gt;Brier, log loss, calibration, coverage&lt;br&gt;ROI only with qualified dated prices" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="810" width="355" height="205" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;● Score upcoming UFC card&lt;/b&gt;&lt;br&gt;Scheduled bout + model version&lt;br&gt;Save UTC cutoff and coverage" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="245" width="355" height="155" as="geometry" />
        </mxCell>
        <mxCell id="refresh" value="&lt;b&gt;● Refresh bookmaker prices&lt;/b&gt;&lt;br&gt;Capture fresh two-sided UFC h2h odds&lt;br&gt;Retain bookmaker update + fetch time" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="429" width="355" height="155" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;● Pre-fight decision gate&lt;/b&gt;&lt;br&gt;Future card + matching roster snapshot&lt;br&gt;Roster age / raw hash / same-run check&lt;br&gt;Quote time order + freshness limit&lt;br&gt;Adverse line drift + stressed edge&lt;br&gt;Save pass / reject reason; recheck line" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="615" width="355" height="225" as="geometry" />
        </mxCell>
        <mxCell id="paper" value="&lt;b&gt;● Capped paper ledger&lt;/b&gt;&lt;br&gt;Freeze accepted gate, quote and stake&lt;br&gt;Default cap: 1% bet / 5% event&lt;br&gt;Settle separately; track open exposure" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="875" width="355" height="165" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="&lt;b&gt;● Separate manual ledger&lt;/b&gt;&lt;br&gt;Human records actual accepted price,&lt;br&gt;stake and payout; no auto placement" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="1060" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="reports" value="&lt;b&gt;● CLI + saved reports&lt;/b&gt;&lt;br&gt;Audit, scores, evaluation, gate checks&lt;br&gt;and paper / manual ledger exports" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="245" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" value="&lt;b&gt;● Read-only Streamlit app&lt;/b&gt;&lt;br&gt;Upcoming card · model evidence&lt;br&gt;data quality · paper / actual ledgers&lt;br&gt;Shows stored integrity report status" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="430" width="365" height="180" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;● Recurring event-day loop&lt;/b&gt;&lt;br&gt;Import → verify → audit → evaluate&lt;br&gt;score → refresh prices → gate → paper&lt;br&gt;Settle; inspect drift and calibration" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="650" width="365" height="185" as="geometry" />
        </mxCell>
        <mxCell id="scale" value="&lt;b&gt;● SQLite backup / restore drill&lt;/b&gt;&lt;br&gt;Create, verify and restore a copy&lt;br&gt;Confirm integrity, counts and FK checks&lt;br&gt;Keep backup outside the live DB path" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="875" width="365" height="175" as="geometry" />
        </mxCell>
