        <mxCell id="ufcstats" value="&lt;b&gt;● UFCStats / reviewed CSV&lt;/b&gt;&lt;br&gt;Historical bouts and cards&lt;br&gt;Parser built; direct fetch may be blocked" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="417" width="355" height="143" as="geometry" />
        </mxCell>
        <mxCell id="oddsapi" value="&lt;b&gt;◇ The Odds API&lt;/b&gt;&lt;br&gt;Current h2h prices + dated snapshots&lt;br&gt;Adapter built; key needed; history is paid" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFBF3;strokeColor=#C67C16;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="589" width="355" height="163" as="geometry" />
        </mxCell>
        <mxCell id="source_review" value="&lt;b&gt;● Source review&lt;/b&gt;&lt;br&gt;Choose primary fight history&lt;br&gt;Check licensing, UFC coverage, full cards" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="61" y="793" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="fetch" value="&lt;b&gt;● Fetch or import&lt;/b&gt;&lt;br&gt;Scheduled CLI runs, date windows&lt;br&gt;Record source, UTC fetch / update times" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="245" width="355" height="143" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;● Immutable source snapshots&lt;/b&gt;&lt;br&gt;Raw JSON / HTML / CSV under data/raw&lt;br&gt;Hash + ingestion_runs receipt" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="417" width="355" height="143" as="geometry" />
        </mxCell>
        <mxCell id="normalize" value="&lt;b&gt;● Normalize UFC bouts &amp; odds&lt;/b&gt;&lt;br&gt;Preserve provider status and quote time&lt;br&gt;Ambiguous fighter / date match is held" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="589" width="355" height="163" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;● Stable fighter ID mapping&lt;/b&gt;&lt;br&gt;Explicit reviewed cross-provider links&lt;br&gt;Never merge fighters on name alone" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="793" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;● SQLite + versioned SQL&lt;/b&gt;&lt;br&gt;fighters · events · bouts · results&lt;br&gt;odds_quotes · predictions · ingestion_runs&lt;br&gt;fighter_external_ids · paper_bets · bets" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="245" width="355" height="185" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;● Audit gate: stop or review&lt;/b&gt;&lt;br&gt;IDs, card completeness, substitutions&lt;br&gt;cancelled / draw / no contest outcomes&lt;br&gt;timestamps, two-sided price coverage" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="475" width="355" height="196" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="&lt;b&gt;! Fix source issues first&lt;/b&gt;&lt;br&gt;Keep uncertain bouts / prices out of&lt;br&gt;model decisions; rerun the audit" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFF1EC;strokeColor=#DB765C;strokeWidth=2;fontColor=#5B2830;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="728" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cutoff" value="&lt;b&gt;● Time contract&lt;/b&gt;&lt;br&gt;UTC event start is a conservative&lt;br&gt;card-level cutoff, not bout start time" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="931" y="915" width="355" height="149" as="geometry" />
        </mxCell>
        <mxCell id="features" value="&lt;b&gt;● Point-in-time features&lt;/b&gt;&lt;br&gt;Replay earlier fights only: Elo, bout&lt;br&gt;count, smoothed win rate, rest" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="245" width="355" height="163" as="geometry" />
        </mxCell>
        <mxCell id="missing_stats" value="&lt;b&gt;○ Dated stats needed later&lt;/b&gt;&lt;br&gt;Age, reach and per-fight metrics are&lt;br&gt;not model inputs yet" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F8F6FF;strokeColor=#7557B8;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="437" width="355" height="133" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;● Probability candidates&lt;/b&gt;&lt;br&gt;Elo + regularized logistic&lt;br&gt;No-vig bookmaker baseline where available" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="602" width="355" height="151" as="geometry" />
        </mxCell>
        <mxCell id="evaluate" value="&lt;b&gt;● Chronological evaluation&lt;/b&gt;&lt;br&gt;Early train → later validation / calibration&lt;br&gt;→ untouched later test events&lt;br&gt;Brier, log loss, quote coverage and&lt;br&gt;return only when historical prices qualify" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1366" y="788" width="355" height="217" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;● Score upcoming UFC card&lt;/b&gt;&lt;br&gt;Verified scheduled bout + model version&lt;br&gt;and UTC feature cutoff; save prediction" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="245" width="355" height="155" as="geometry" />
        </mxCell>
        <mxCell id="refresh" value="&lt;b&gt;● Refresh bookmaker prices&lt;/b&gt;&lt;br&gt;Capture the latest UFC h2h quote&lt;br&gt;Keep bookmaker update and capture times" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="429" width="355" height="151" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;● Local pre-fight alert gate&lt;/b&gt;&lt;br&gt;Future known card start · same fresh run&lt;br&gt;quote-age limit · adverse price stress&lt;br&gt;minimum expected profit after stress&lt;br&gt;Pass / reject; human rechecks the line" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="615" width="355" height="220" as="geometry" />
        </mxCell>
        <mxCell id="paper" value="&lt;b&gt;● Capped paper ledger&lt;/b&gt;&lt;br&gt;Freeze quote, prediction, stake, result&lt;br&gt;Default cap: 1% per bet / 5% per event" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="875" width="355" height="163" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="&lt;b&gt;● Separate manual ledger&lt;/b&gt;&lt;br&gt;Human enters actual accepted price,&lt;br&gt;stake and payout; no auto placement" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1801" y="1061" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="reports" value="&lt;b&gt;● CLI + timestamped CSV&lt;/b&gt;&lt;br&gt;Event scores, audit, evaluation and&lt;br&gt;paper / manual ledger reports" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="245" width="365" height="155" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" value="&lt;b&gt;○ Read-only Streamlit dashboard&lt;/b&gt;&lt;br&gt;Upcoming card · model evidence&lt;br&gt;data quality · paper and actual ledgers&lt;br&gt;Reads stored, verified data" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F8F6FF;strokeColor=#7557B8;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="429" width="365" height="178" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;○ Recurring operating loop&lt;/b&gt;&lt;br&gt;Import → audit → evaluate → score&lt;br&gt;refresh quote → alert check → settle&lt;br&gt;review drift, calibration and exposure" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F8F6FF;strokeColor=#7557B8;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2236" y="650" width="365" height="186" as="geometry" />
        </mxCell>
        <mxCell id="scale" value="&lt;b&gt;○ Scale only if needed&lt;/b&gt;&lt;br&gt;PostgreSQL + API / auth / worker for&lt;br&gt;shared or unattended operation" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F8F6FF;strokeColor=#7557B8;strokeWidth=2;dashed=1;dashPattern=7 4;fontColor=#153047;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="1">
