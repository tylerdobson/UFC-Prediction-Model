        <mxCell id="boundary" value="&lt;b&gt;RELEASE BOUNDARY&lt;/b&gt;  Pre-fight only · local alerts and paper decisions · no automatic orders · real-data readiness still requires source rights, credentials and prospective paper evidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#102338;strokeColor=#102338;fontColor=#FFFFFF;fontSize=19;align=left;verticalAlign=middle;spacingLeft=20;" vertex="1" parent="1">
