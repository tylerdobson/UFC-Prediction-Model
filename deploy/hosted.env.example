# Copy to deploy/hosted.env on the server. The real file is Git-ignored.
# Use the physical checkout path on the Linux host. Restore retained evidence
# under data/ and provision native MySQL datasets before starting the app.
UFC_DEPLOY_ROOT=/opt/ufc-prediction-model
UFC_MODEL_DB=mysql:operating
UFC_MODEL_HISTORY_DB=mysql:research-complete
UFC_MODEL_STATISTICS_DB=mysql:statistics
# Owner-only external config, containing the project application credentials.
UFC_MYSQL_CONFIG_FILE=/opt/ufc-prediction-model/deploy/secrets/mysql.json
# Reachable from the container. Linux MySQL must listen on a private interface;
# host.docker.internal cannot reach a server bound only to host loopback.
UFC_DOCKER_MYSQL_HOST=host.docker.internal
UFC_MYSQL_PORT=3307
# Original workstation root embedded in the unchanged forward-research reports.
# Set this only when the copied data/, reports/, and docs/ have been verified.
UFC_FORWARD_SOURCE_ROOT=/Users/tylerjamesdobson/Documents/ChatGPT/Projects/UFC-Prediction-Model
UFC_DEPLOY_UID=REPLACE_WITH_ID_U
UFC_DEPLOY_GID=REPLACE_WITH_ID_G
UFC_GITHUB_USER=REPLACE_WITH_EXACT_GITHUB_USERNAME
UFC_GITHUB_OAUTH_CLIENT_ID=REPLACE_WITH_OAUTH_APP_CLIENT_ID
