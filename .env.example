# Copy to .env, fill in your key, and keep file permissions at 0600.
# The local CLI reads this file from its current working directory. Exported
# shell variables take precedence. The read-only dashboard never uses the key.
# The Odds API provides live h2h prices; historical snapshots require its historical plan.
ODDS_API_KEY=
# Optional Sportradar adapter: its free trial is internal evaluation only; betting-related use requires written approval under current terms.
SPORTRADAR_API_KEY=
